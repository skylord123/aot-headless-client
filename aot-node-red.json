  {
    "id": "2e40cad401210acf",
    "type": "function",
    "z": "7ed3b854ed04dbfa",
    "g": "ab8274dc0a65d1a3",
    "name": "Sync Clock",
    "func": "// Incoming uptime from the server\nconst newUptime = msg.payload.uptime_seconds;\nif (typeof newUptime !== \"number\") {\n    node.error(\"sync_clock without numeric uptime_seconds\", msg);\n    return null;\n}\n\n// When we received this reading (ms since epoch). Prefer the bot's own\n// timestamp so Node-RED queueing delays don't skew the math.\nconst receivedAt = (typeof msg.payload.received_at === \"number\")\n    ? msg.payload.received_at * 1000\n    : Date.now();\n\n// Last reading we saw (undefined on first run / after a Node-RED restart)\nconst last = flow.get(\"lastSync\");\n\n// Always save the new reading for next time\nflow.set(\"lastSync\", { uptime: newUptime, at: receivedAt });\n\n// First reading — nothing to compare against, treat as normal\nif (!last || typeof last.uptime !== \"number\" || typeof last.at !== \"number\") {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"init: \" + newUptime + \"s\" });\n    return [null, msg];\n}\n\n// Real seconds that passed between the two readings\nconst elapsed = Math.max(0, (receivedAt - last.at) / 1000);\n\n// If the server never restarted, its uptime should now be roughly\n// lastUptime + elapsed. A restart anywhere in the gap caps reported\n// uptime at `elapsed`, so it falls short of expected by at least\n// lastUptime. The server under-reports uptime when bogged down, so\n// only call it a restart when we're below HALF of expected.\nconst expected = last.uptime + elapsed;\n\n// Uptime going backwards is always a restart: a bogged-down counter\n// runs slow, but it never runs backwards.\nconst restarted = newUptime < last.uptime || newUptime < expected * 0.5;\n\nif (restarted) {\n    msg.previous_uptime = last.uptime;\n    msg.expected_uptime = Math.round(expected);\n    msg.gap_seconds = Math.round(elapsed);\n    node.status({ fill: \"red\", shape: \"dot\", text: \"restart detected\" });\n    return [msg, null];\n}\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"up \" + newUptime + \"s (~\" + Math.round(expected) + \"s expected)\" });\nreturn [null, msg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 320,
